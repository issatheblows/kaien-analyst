{
  "manifest_version": 3,
  "name": "kaien analyst",
  "version": "0.1.0",
  "description": "Finance content analytics for X: what topics and videos perform best, AI post writer and quote-post publishing with limits.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://openrouter.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "src/background.js" },
  "action": { "default_title": "kaien analyst", "default_popup": "src/popup.html" },
  "options_page": "src/options.html",
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://twitter.com/*"],
    "js": ["src/domain.js", "src/content.js"],
    "run_at": "document_idle"
  }]
}
